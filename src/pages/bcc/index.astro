---
import "../../styles/global.css";

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const canonical = new URL(`${home}bcc/`, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Lars Corneliussen is an active member of Brunstad Christian Church (BCC) and DCG Waltrop."
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${home}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="BCC involvement — Lars Corneliussen" />
    <meta
      property="og:description"
      content="Faith, church community, and active involvement in Brunstad Christian Church."
    />
    <meta property="og:url" content={canonical} />
    <title>BCC involvement — Lars Corneliussen</title>
  </head>
  <body class="content-page bcc-viewport">
    <header class="shell site-header">
      <a class="wordmark" href={home}>
        <img src={`${home}lc-mark.svg`} alt="" width="28" height="28" />
        <span>Lars Corneliussen</span>
      </a>
      <div class="header-links">
        <nav class="site-nav page-nav" aria-label="Main navigation">
          <a class="nav-link" href={`${home}#work`}>
            Work
          </a>
          <a
            class="nav-link is-active"
            href={`${home}bcc/`}
            aria-current="page"
          >
            Church
          </a>
          <a class="nav-link" href={`${home}about/`}>
            Private
          </a>
        </nav>
        <nav class="social-links" aria-label="Social profiles">
          <a
            href="https://github.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
          <a
            href="https://de.linkedin.com/in/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a
            href="https://x.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="X"
            title="X"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="shell bcc-page">
      <section class="bcc-hero">
        <div>
          <p class="eyebrow">Faith · Community · Service</p>
          <h1>Active in DCG Waltrop.</h1>
          <p class="intro">
            Faith and church community are an important part of my life—locally
            at DCG Waltrop and in the wider international fellowship of BCC
            (called DCG in Germany).
          </p>
        </div>
        <div class="bcc-monogram" aria-hidden="true">
          BCC
        </div>
      </section>

      <nav class="bcc-tabs" role="tablist" aria-label="BCC page sections">
        <button
          class="nav-tab is-active"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="bcc-dcg"
          data-bcc-tab="dcg"
        >
          Volunteering
        </button>
        <button
          class="nav-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="bcc-about-panel"
          data-bcc-tab="about"
        >
          About BCC
        </button>
      </nav>

      <div class="bcc-panels">
        <section
          id="bcc-dcg"
          class="bcc-panel bcc-dcg-panel is-visible"
          role="tabpanel"
          data-bcc-panel="dcg"
          aria-labelledby="dcg-waltrop-title"
        >
          <div class="dcg-panel-head">
            <div>
              <p class="eyebrow">Local church · DCG Waltrop</p>
              <h2 id="dcg-waltrop-title">Where I take responsibility.</h2>
            </div>
            <div
              class="reel-controls"
              aria-label="Responsibility carousel controls"
            >
              <span class="reel-status" data-dcg-status>
                01 / 03
              </span>
              <button
                type="button"
                data-dcg-prev
                aria-label="Previous responsibility"
              >
                ←
              </button>
              <button
                type="button"
                data-dcg-next
                aria-label="Next responsibility"
              >
                →
              </button>
            </div>
          </div>
          <div
            class="dcg-responsibilities"
            data-dcg-reel
            tabindex="0"
            aria-label="Responsibilities at DCG Waltrop. Swipe or use arrow keys to browse."
          >
            <article class="dcg-card dcg-card-events">
              <div class="dcg-card-top">
                <span class="dcg-card-number">01</span>
                <span class="dcg-card-mark" aria-hidden="true">
                  PL
                </span>
              </div>
              <div>
                <p class="eyebrow">On rotation</p>
                <h3>Event leadership &amp; production</h3>
                <p>
                  Serving as project lead or producer for anniversaries,
                  weddings, funerals and memorial services, summer and Christmas
                  celebrations, and retreats.
                </p>
                <div class="dcg-app-links">
                  <a href="https://jenda.run" target="_blank" rel="noreferrer">
                    jenda.run ↗
                  </a>
                  <a
                    href="https://about.weeks.app"
                    target="_blank"
                    rel="noreferrer"
                  >
                    weeks.app ↗
                  </a>
                  <a
                    href="https://kaessli.app"
                    target="_blank"
                    rel="noreferrer"
                  >
                    kaessli.app ↗
                  </a>
                </div>
              </div>
            </article>

            <article class="dcg-card dcg-card-tech">
              <div class="dcg-card-top">
                <span class="dcg-card-number">02</span>
                <span class="dcg-card-mark" aria-hidden="true">
                  AV
                </span>
              </div>
              <div>
                <p class="eyebrow">Responsible</p>
                <h3>Event technology &amp; media</h3>
                <p>
                  Taking responsibility for technical production and media—from
                  dependable systems to sound, visuals, and content delivery.
                </p>
              </div>
            </article>

            <article class="dcg-card dcg-card-action">
              <div class="dcg-card-top">
                <span class="dcg-card-number">03</span>
                <span class="dcg-card-mark" aria-hidden="true">
                  +
                </span>
              </div>
              <div>
                <p class="eyebrow">Responsible</p>
                <h3>Community initiatives &amp; fundraising</h3>
                <p>
                  Organising practical initiatives and fundraising activities
                  that bring people together and help finance shared goals.
                </p>
                <div class="dcg-app-links">
                  <span>Still needs the right software :D</span>
                </div>
              </div>
            </article>
          </div>
          <a
            class="text-link dcg-site-link"
            href="https://dcg-deutschland.de/waltrop/"
            target="_blank"
            rel="noreferrer"
          >
            Visit DCG Waltrop ↗
          </a>
        </section>

        <section
          id="bcc-about-panel"
          class="bcc-panel bcc-resources-panel"
          role="tabpanel"
          data-bcc-panel="about"
          aria-labelledby="bcc-about-title"
          hidden
        >
          <div class="bcc-resource-grid">
            <div class="bcc-about-copy">
              <p class="eyebrow">About BCC</p>
              <h2 id="bcc-about-title">A worldwide Christian fellowship.</h2>
              <p>
                Brunstad Christian Church is an international Christian church
                with origins in Norway and fellow believers across the world.
                Its church life centres on following Jesus, personal
                discipleship, and active Christian fellowship—with substantial
                work for children and young people.
              </p>
            </div>
            <div class="bcc-links">
              <a href="https://bcc.no/en/" target="_blank" rel="noreferrer">
                <span>BCC international</span>
                <small>bcc.no ↗</small>
              </a>
              <a
                href="https://dcg-deutschland.de/"
                target="_blank"
                rel="noreferrer"
              >
                <span>DCG Deutschland</span>
                <small>German community ↗</small>
              </a>
              <a
                href="https://hiddentreasures.org/"
                target="_blank"
                rel="noreferrer"
              >
                <span>Hidden Treasures</span>
                <small>Christian literature ↗</small>
              </a>
              <a
                href="https://songtreasures.org/"
                target="_blank"
                rel="noreferrer"
              >
                <span>Song Treasures</span>
                <small>Songs and melodies ↗</small>
              </a>
            </div>
          </div>
          <article class="bcc-music" aria-labelledby="hidden-treasures-title">
            <div class="bcc-music-copy">
              <p class="eyebrow">Listen</p>
              <h2 id="hidden-treasures-title">Hidden Treasures Music</h2>
            </div>
            <div class="youtube-embed">
              <iframe
                src="https://www.youtube-nocookie.com/embed/videoseries?list=UUiV8lrthFAR39OEC6IvYIjg"
                title="Recent uploads from Hidden Treasures Music"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <a
              class="text-link"
              href="https://www.youtube.com/@HiddenTreasuresMusic"
              target="_blank"
              rel="noreferrer"
            >
              Open channel ↗
            </a>
          </article>
        </section>
      </div>
    </main>

    <footer class="shell compact-footer content-footer">
      <span>© {year} Lars Corneliussen</span>
      <a href={home}>Back to portfolio</a>
    </footer>
    <script is:inline>
      (() => {
        const tabs = [...document.querySelectorAll("[data-bcc-tab]")];
        const panels = [...document.querySelectorAll("[data-bcc-panel]")];

        function showPanel(id, updateHash = true) {
          tabs.forEach((tab) => {
            const active = tab.dataset.bccTab === id;
            tab.classList.toggle("is-active", active);
            tab.setAttribute("aria-selected", String(active));
          });
          panels.forEach((panel) => {
            const active = panel.dataset.bccPanel === id;
            panel.classList.toggle("is-visible", active);
            panel.hidden = !active;
            if (active) panel.dispatchEvent(new Event("panelshown"));
          });
          if (updateHash)
            history.replaceState(
              null,
              "",
              id === "dcg" ? location.pathname : `#${id}`,
            );
        }

        tabs.forEach((tab) =>
          tab.addEventListener("click", () => showPanel(tab.dataset.bccTab)),
        );
        document
          .querySelectorAll("[data-open-bcc-panel]")
          .forEach((button) =>
            button.addEventListener("click", () =>
              showPanel(button.dataset.openBccPanel),
            ),
          );

        const initial = location.hash === "#about" ? "about" : "dcg";
        showPanel(initial, false);

        const reel = document.querySelector("[data-dcg-reel]");
        if (!reel) return;
        const cards = [...reel.children];
        const status = document.querySelector("[data-dcg-status]");
        const step = () =>
          cards[1]
            ? cards[1].offsetLeft - cards[0].offsetLeft
            : reel.clientWidth;
        const index = () => {
          const size = step();
          return size > 0
            ? Math.max(
                0,
                Math.min(cards.length - 1, Math.round(reel.scrollLeft / size)),
              )
            : 0;
        };
        const update = () =>
          (status.textContent = `${String(index() + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`);
        const move = (direction) => {
          const next = (index() + direction + cards.length) % cards.length;
          reel.scrollTo({
            left: cards[next].offsetLeft,
            behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth",
          });
        };
        document
          .querySelector("[data-dcg-prev]")
          ?.addEventListener("click", () => move(-1));
        document
          .querySelector("[data-dcg-next]")
          ?.addEventListener("click", () => move(1));
        reel.addEventListener("scroll", update, { passive: true });
        reel
          .closest("[data-bcc-panel]")
          ?.addEventListener("panelshown", () => requestAnimationFrame(update));
        reel.addEventListener("keydown", (event) => {
          if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
            event.preventDefault();
            move(event.key === "ArrowRight" ? 1 : -1);
          }
        });
        update();
      })();
    </script>
  </body>
</html>
