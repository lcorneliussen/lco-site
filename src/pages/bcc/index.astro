---
import "../../styles/global.css";

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const canonical = new URL(`${home}bcc/`, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Lars Corneliussen is an active member of Brunstad Christian Church (BCC)."
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="BCC involvement — Lars Corneliussen"
    />
    <meta
      property="og:description"
      content="Faith, church community, and active involvement in Brunstad Christian Church."
    />
    <meta property="og:url" content={canonical} />
    <title>BCC involvement — Lars Corneliussen</title>
  </head>
  <body class="content-page">
    <header class="shell site-header">
      <a class="wordmark" href={home}>Lars Corneliussen</a>
      <div class="header-links">
        <nav class="site-nav page-nav" aria-label="Main navigation">
          <a class="nav-link" href={`${home}#work`}>Work</a>
          <a class="nav-link" href={`${home}#interests`}>Interests</a>
          <a class="nav-link is-active" href={`${home}bcc/`} aria-current="page">
            BCC
          </a>
        </nav>
        <nav class="social-links" aria-label="Social profiles">
          <a
            href="https://github.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
          <a
            href="https://de.linkedin.com/in/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a
            href="https://x.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="X"
            title="X"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="shell bcc-page">
      <section class="bcc-hero">
        <div>
          <p class="eyebrow">Faith · Community · Service</p>
          <h1>Active member in Brunstad Christian Church.</h1>
          <p class="intro">
            Faith and church community are an important part of my life. I take
            an active part in local church life and in the wider international
            fellowship of BCC.
          </p>
        </div>
        <div class="bcc-monogram" aria-hidden="true">BCC</div>
      </section>

      <section class="bcc-content" aria-labelledby="about-bcc">
        <article class="bcc-about">
          <p class="eyebrow">About BCC</p>
          <h2 id="about-bcc">A worldwide Christian fellowship.</h2>
          <p>
            Brunstad Christian Church is an international Christian church with
            origins in Norway and fellow believers across the world. Its church
            life centres on following Jesus, personal discipleship, and active
            Christian fellowship—with substantial work for children and young
            people.
          </p>
          <div class="bcc-links">
            <a href="https://bcc.no/en/" target="_blank" rel="noreferrer">
              <span>BCC international</span>
              <small>bcc.no ↗</small>
            </a>
            <a
              href="https://dcg-deutschland.de/"
              target="_blank"
              rel="noreferrer"
            >
              <span>DCG Deutschland</span>
              <small>German church community ↗</small>
            </a>
            <a
              href="https://hiddentreasures.org/"
              target="_blank"
              rel="noreferrer"
            >
              <span>Hidden Treasures</span>
              <small>Christian literature ↗</small>
            </a>
            <a
              href="https://songtreasures.org/"
              target="_blank"
              rel="noreferrer"
            >
              <span>Song Treasures</span>
              <small>Songs and melodies ↗</small>
            </a>
          </div>
        </article>

        <article class="bcc-music" aria-labelledby="hidden-treasures-title">
          <div class="bcc-music-copy">
            <p class="eyebrow">Listen</p>
            <h2 id="hidden-treasures-title">Hidden Treasures Music</h2>
            <p>Recent music from the channel’s public uploads.</p>
          </div>
          <div class="youtube-embed">
            <iframe
              src="https://www.youtube-nocookie.com/embed/videoseries?list=UUiV8lrthFAR39OEC6IvYIjg"
              title="Recent uploads from Hidden Treasures Music"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <a
            class="text-link"
            href="https://www.youtube.com/@HiddenTreasuresMusic"
            target="_blank"
            rel="noreferrer"
          >
            Open channel on YouTube ↗
          </a>
        </article>
      </section>
    </main>

    <footer class="shell compact-footer content-footer">
      <span>© {year} Lars Corneliussen</span>
      <a href={home}>Back to portfolio</a>
    </footer>
  </body>
</html>
