---
import { interests, projects } from "../data/projects";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const canonical = new URL(home, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Lars Corneliussen builds software products, teams, and the systems around them."
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Lars Corneliussen — Builder & technologist"
    />
    <meta
      property="og:description"
      content="Software products, long-term client work, open-source contributions, and current interests."
    />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>Lars Corneliussen — Builder & technologist</title>
  </head>
  <body>
    <header class="shell site-header">
      <a class="wordmark" href={home}>
        Lars Corneliussen
      </a>
      <div class="header-links">
        <nav class="site-nav" aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href="#interests">Interests</a>
          <a href="#elsewhere">Elsewhere</a>
        </nav>
        <nav class="social-links" aria-label="Social profiles">
          <a
            href="https://github.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.28-.36 6.72-1.61 6.72-7.25A5.65 5.65 0 0 0 19.22 3.3 5.3 5.3 0 0 0 19.08 0S17.9-.36 15 1.48a13.38 13.38 0 0 0-6 0C6.1-.36 4.92 0 4.92 0a5.3 5.3 0 0 0-.14 3.3 5.65 5.65 0 0 0-1.5 3.95c0 5.62 3.44 6.89 6.72 7.25A4.8 4.8 0 0 0 9 18v4" />
              <path d="M9 19c-3 .92-3-1.5-4-2" />
            </svg>
          </a>
          <a
            href="https://de.linkedin.com/in/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
              <path d="M2 9h4v12H2z" />
              <path d="M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
            </svg>
          </a>
          <a
            href="https://x.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="X"
            title="X"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m4 4 16 16" />
              <path d="M20 4 4 20" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="shell">
      <div class="hero">
        <div>
          <p class="eyebrow">Builder · Technologist · Partner</p>
          <h1>I build software and the teams around it.</h1>
          <p class="intro">
            I work where products, operations, and people meet — creating tools,
            growing platforms, and staying with hard problems long enough to
            make them simple.
          </p>
        </div>
        <aside class="hero-profile" aria-label="About Lars Corneliussen">
          <img
            src={`${home}lars-corneliussen.jpg`}
            alt="Lars Corneliussen"
            width="170"
            height="170"
          />
          <div class="hero-note">
            <strong>Based in Germany, working across Europe.</strong>
            <p>
              Founder of Talendos. Product builder, long-term engineering
              partner, open-source contributor, and relentless simplifier.
            </p>
          </div>
        </aside>
      </div>

      <section id="work" aria-labelledby="work-title">
        <div class="section-head">
          <h2 id="work-title">Selected work</h2>
          <p class="section-copy">
            Products I started, companies I help shape, and client relationships
            that became much more than projects.
          </p>
        </div>

        <div class="project-grid">
          {projects.map((project, index) => (
            <a
              class:list={["project-card", `tone-${project.tone}`]}
              href={project.href}
              target="_blank"
              rel="noreferrer"
            >
              <div class="project-card-top">
                <p class="card-label">{project.label}</p>
                <span class="project-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <div class="project-mark" aria-hidden="true">
                {project.mark}
              </div>
              <div class="project-copy">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section id="interests" aria-labelledby="interests-title">
        <div class="section-head">
          <h2 id="interests-title">Open source & current interests</h2>
          <p class="section-copy">
            I like systems that are malleable, transparent, and built in public.
            Right now much of that energy goes into Omarchy and the growing
            ecosystem around it.
          </p>
        </div>

        <div class="interest-list">
          {interests.map((interest) => (
            <article class="interest-item">
              <h3>{interest.name}</h3>
              <p>{interest.description}</p>
              <div class="interest-links">
                <a
                  class="text-link"
                  href={interest.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  Explore ↗
                </a>
                {interest.secondaryHref && (
                  <a
                    class="text-link"
                    href={interest.secondaryHref}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {interest.secondaryLabel} ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="elsewhere" class="contact" aria-labelledby="elsewhere-title">
        <h2 id="elsewhere-title">Follow the work as it happens.</h2>
        <div class="contact-links">
          <a
            class="pill"
            href="https://github.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
          >
            GitHub ↗
          </a>
          <a
            class="pill"
            href="https://de.linkedin.com/in/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
          >
            LinkedIn ↗
          </a>
          <a
            class="pill"
            href="https://x.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
          >
            X / Twitter ↗
          </a>
        </div>
      </section>
    </main>

    <footer class="shell">
      <span>© {year} Lars Corneliussen</span>
      <span>Built with Astro. Hosted on GitHub Pages.</span>
    </footer>
  </body>
</html>
