---
import { interests, projects } from "../data/projects";
import { getXProfileStatus } from "../lib/x-profile";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const canonical = new URL(home, Astro.site);
const year = new Date().getFullYear();
const xProfile = await getXProfileStatus();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Lars Corneliussen builds software products, teams, and the systems around them."
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${home}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Lars Corneliussen — Builder & technologist"
    />
    <meta
      property="og:description"
      content="Software products, long-term client work, open-source contributions, and current interests."
    />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>Lars Corneliussen — Builder & technologist</title>
  </head>
  <body>
    <header class="shell site-header">
      <a class="wordmark" href={home}>
        <img src={`${home}lc-mark.svg`} alt="" width="28" height="28" />
        <span>Lars Corneliussen</span>
      </a>
      <div class="header-links">
        <nav class="site-nav" aria-label="Portfolio sections">
          <button
            class="nav-tab is-active"
            type="button"
            data-show-panel="work"
            aria-controls="work"
            aria-selected="true"
          >
            Work
          </button>
          {xProfile?.isFresh && (
            <button
              class="nav-tab"
              type="button"
              data-show-panel="on-x"
              aria-controls="on-x"
              aria-selected="false"
            >
              Updates
            </button>
          )}
          <a class="nav-link" href={`${home}bcc/`}>
            Church
          </a>
          <a class="nav-link" href={`${home}about/`}>
            Personal
          </a>
        </nav>
        <nav class="social-links" aria-label="Social profiles">
          <a
            href="https://github.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
          <a
            href="https://de.linkedin.com/in/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a
            href="https://x.com/lcorneliussen"
            target="_blank"
            rel="me noreferrer"
            aria-label="X"
            title="X"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="shell viewport-main">
      <div class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Builder · Technologist · Partner</p>
          <h1>I build software and the teams around it.</h1>
          <p class="intro">
            I work where products, operations, and people meet — creating tools,
            growing platforms, and staying with hard problems long enough to
            make them simple.
          </p>
        </div>
        <aside class="hero-profile" aria-label="About Lars Corneliussen">
          <img
            src={`${home}lars-corneliussen.jpg`}
            alt="Lars Corneliussen"
            width="170"
            height="170"
          />
          <div class="hero-note">
            <strong>Germany · Europe</strong>
            <p>
              Founder of Talendos. Product builder, engineering partner,
              open-source contributor.
            </p>
          </div>
        </aside>
      </div>

      <div class="showcase" aria-live="polite">
        <nav class="mobile-tabs" aria-label="Portfolio sections">
          <button
            class="nav-tab is-active"
            type="button"
            data-show-panel="work"
            aria-controls="work"
            aria-selected="true"
          >
            Work
          </button>
          <button
            class="nav-tab"
            type="button"
            data-show-panel="interests"
            aria-controls="interests"
            aria-selected="false"
          >
            Interests
          </button>
          {xProfile?.isFresh && (
            <button
              class="nav-tab"
              type="button"
              data-show-panel="on-x"
              aria-controls="on-x"
              aria-selected="false"
            >
              Updates
            </button>
          )}
        </nav>
        <section
          id="work"
          class="showcase-panel is-active is-visible"
          aria-labelledby="work-title"
          data-panel="work"
        >
          <div class="showcase-head">
            <div>
              <p class="eyebrow">Selected work</p>
              <h2 id="work-title">Things I build.</h2>
            </div>
            <div class="reel-controls" aria-label="Work carousel controls">
              <span class="reel-status" data-reel-status>
                01 / {String(projects.length).padStart(2, "0")}
              </span>
              <button
                type="button"
                data-reel-prev
                aria-label="Previous projects"
              >
                ←
              </button>
              <button type="button" data-reel-next aria-label="Next projects">
                →
              </button>
            </div>
          </div>
          <div
            class="card-reel project-reel"
            data-reel
            data-autoplay="true"
            tabindex="0"
            aria-label="Selected work. Swipe or use arrow keys to browse."
          >
            {projects.map((project, index) => (
              <a
                class:list={["project-card", `tone-${project.tone}`]}
                href={project.href}
                target="_blank"
                rel="noreferrer"
              >
                <div class="project-card-top">
                  <p class="card-label">{project.label}</p>
                  <span class="project-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>
                {project.image ? (
                  <div class="project-visual" aria-hidden="true">
                    <img
                      src={`${home}${project.image}`}
                      alt=""
                      width="720"
                      height="405"
                      loading={index < 4 ? "eager" : "lazy"}
                    />
                  </div>
                ) : (
                  <div class="project-mark" aria-hidden="true">
                    {project.mark}
                  </div>
                )}
                <div class="project-copy">
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section
          id="interests"
          class="showcase-panel"
          aria-labelledby="interests-title"
          data-panel="interests"
        >
          <div class="showcase-head">
            <div>
              <p class="eyebrow">Open source · Contributions</p>
              <h2 id="interests-title">Things I contribute.</h2>
            </div>
            <div class="reel-controls" aria-label="Interest carousel controls">
              <span class="reel-status" data-reel-status>
                01 / {String(interests.length).padStart(2, "0")}
              </span>
              <button
                type="button"
                data-reel-prev
                aria-label="Previous interests"
              >
                ←
              </button>
              <button type="button" data-reel-next aria-label="Next interests">
                →
              </button>
            </div>
          </div>
          <div
            class="card-reel interest-reel"
            data-reel
            tabindex="0"
            aria-label="Open-source interests. Swipe or use arrow keys to browse."
          >
            {interests.map((interest, index) => (
              <article
                class:list={["interest-item", { "has-visual": interest.image }]}
              >
                <span class="project-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="interest-kind">{interest.kind}</span>
                {interest.image ? (
                  <div class="interest-visual" aria-hidden="true">
                    <img
                      src={`${home}${interest.image}`}
                      alt=""
                      width="720"
                      height="405"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <span class="interest-mark" aria-hidden="true">
                    {interest.mark}
                  </span>
                )}
                <h3>{interest.name}</h3>
                <p>{interest.description}</p>
                <div class="interest-links">
                  <a
                    class="text-link"
                    href={interest.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {interest.primaryLabel ?? "Explore"} ↗
                  </a>
                  {interest.secondaryHref && (
                    <a
                      class="text-link"
                      href={interest.secondaryHref}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {interest.secondaryLabel} ↗
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        {xProfile?.isFresh && (
          <section
            id="on-x"
            class="showcase-panel x-feed"
            aria-labelledby="x-feed-title"
            data-latest-post-at={xProfile.latestPostAt}
            data-panel="on-x"
          >
            <div class="showcase-head">
              <div>
                <p class="eyebrow">Latest on X</p>
                <h2 id="x-feed-title">What I’m thinking.</h2>
              </div>
            </div>
            <div class="x-timeline-shell">
              <a
                class="twitter-timeline"
                data-chrome="noheader nofooter noborders transparent"
                data-dnt="true"
                data-tweet-limit="3"
                data-theme="light"
                href="https://x.com/lcorneliussen"
              >
                Posts by @lcorneliussen
              </a>
            </div>
            <script
              is:inline
              src="https://platform.twitter.com/widgets.js"
              async
              charset="utf-8"
            ></script>
            <script is:inline>
              {
                `
                (() => {
                  const section = document.querySelector("[data-latest-post-at]");
                  if (!section) return;
                  const latest = Date.parse(section.dataset.latestPostAt || "");
                  if (!Number.isFinite(latest) || Date.now() - latest > 14 * 24 * 60 * 60 * 1000) {
                    section.hidden = true;
                  }
                })();
              `;
              }
            </script>
          </section>
        )}
      </div>
    </main>

    <footer class="shell compact-footer">
      <span>© {year} Lars Corneliussen</span>
      <span>Astro · GitHub Pages</span>
    </footer>
    <script is:inline>
      (() => {
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        const tabs = [...document.querySelectorAll("[data-show-panel]")];
        const panels = [...document.querySelectorAll("[data-panel]")];

        const dualLayout = matchMedia(
          "(min-width: 62rem) and (min-height: 48rem)",
        );
        let activePanel = location.hash === "#interests" ? "interests" : "work";

        function syncPanels() {
          const showBoth = dualLayout.matches && activePanel !== "on-x";
          tabs.forEach((tab) => {
            const active = tab.dataset.showPanel === activePanel;
            tab.classList.toggle("is-active", active);
            tab.setAttribute("aria-selected", String(active));
          });
          panels.forEach((panel) => {
            const visible = showBoth
              ? panel.dataset.panel === "work" ||
                panel.dataset.panel === "interests"
              : panel.dataset.panel === activePanel;
            panel.classList.toggle("is-visible", visible);
            panel.setAttribute("aria-hidden", String(!visible));
            if (visible) panel.dispatchEvent(new Event("panelshown"));
          });
        }

        function showPanel(id) {
          activePanel = id;
          syncPanels();
        }

        tabs.forEach((tab) =>
          tab.addEventListener("click", () => showPanel(tab.dataset.showPanel)),
        );
        dualLayout.addEventListener("change", syncPanels);
        syncPanels();

        document.querySelectorAll("[data-reel]").forEach((reel) => {
          const panel = reel.closest("[data-panel]");
          const cards = [...reel.children];
          const status = panel.querySelector("[data-reel-status]");
          let paused = false;
          let userControlled = false;
          let timer;

          const stopAutoplay = () => {
            if (userControlled) return;
            userControlled = true;
            reel.dataset.autoplayStopped = "true";
            clearInterval(timer);
          };

          const cardStep = () =>
            cards[1]
              ? cards[1].offsetLeft - cards[0].offsetLeft
              : reel.clientWidth;
          const visibleCount = () =>
            Math.max(1, Math.floor((reel.clientWidth + 8) / cardStep()));
          const activeIndex = () => {
            const step = cardStep();
            return step > 0
              ? Math.max(
                  0,
                  Math.min(
                    cards.length - 1,
                    Math.round(reel.scrollLeft / step),
                  ),
                )
              : 0;
          };
          const update = () => {
            if (status)
              status.textContent = `${String(activeIndex() + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
          };
          const move = (direction) => {
            const count = visibleCount();
            const current = activeIndex();
            const lastStart = Math.max(0, cards.length - count);
            let next = direction > 0 ? current + count : current - count;
            if (next > lastStart) next = 0;
            if (next < 0) next = lastStart;
            reel.scrollTo({
              left: cards[next]?.offsetLeft || 0,
              behavior: reducedMotion.matches ? "auto" : "smooth",
            });
          };

          panel
            .querySelector("[data-reel-prev]")
            ?.addEventListener("click", () => {
              stopAutoplay();
              move(-1);
            });
          panel
            .querySelector("[data-reel-next]")
            ?.addEventListener("click", () => {
              stopAutoplay();
              move(1);
            });
          reel.addEventListener("scroll", update, { passive: true });
          panel.addEventListener("panelshown", update);
          reel.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
              event.preventDefault();
              stopAutoplay();
              move(event.key === "ArrowRight" ? 1 : -1);
            }
          });
          ["pointerdown", "touchstart", "wheel"].forEach((name) =>
            reel.addEventListener(name, stopAutoplay, { passive: true }),
          );
          ["mouseenter", "focusin"].forEach((name) =>
            reel.addEventListener(name, () => (paused = true), {
              passive: true,
            }),
          );
          ["mouseleave", "focusout"].forEach((name) =>
            reel.addEventListener(name, () => (paused = false), {
              passive: true,
            }),
          );

          if (reel.dataset.autoplay === "true") {
            timer = setInterval(() => {
              if (
                !paused &&
                !userControlled &&
                !document.hidden &&
                !reducedMotion.matches &&
                panel.classList.contains("is-visible")
              )
                move(1);
            }, 5200);
          }
          addEventListener("beforeunload", () => clearInterval(timer), {
            once: true,
          });
          update();
        });
      })();
    </script>
  </body>
</html>
